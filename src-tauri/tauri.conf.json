{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mo Fish Reader",
  "version": "1.0.0",
  "identifier": "com.local.mofishreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mo Fish Reader",
        "width": 920,
        "height": 680,
        "minWidth": 620,
        "minHeight": 440,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Terminal-disguised local TXT reader",
    "longDescription": "A local-first TXT reader that mimics a working terminal for quiet reading at work."
  }
}
